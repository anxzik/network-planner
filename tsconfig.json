{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "forge.config.ts",
    "forge.env.d.ts",
    "vite.*.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".vite",
    "out",
    "networkplanner"
  ]
}
